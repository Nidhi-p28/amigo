# Set 1 for Stage 1 (chat only), 2 for Stage 2 (desktop/file tools), 3 for Stage 3 (cloud routing + web research).
AMIGO_STAGE=1

# Must exactly match a model shown by: ollama list
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434

# Needed for Stage 3 cloud reasoning and grounded web research.
# Get a key from https://aistudio.google.com/
# Keep the real key only in your local .env file; never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
